+		t.Fatalf("updated=%#v err=%v", updated, err)
+	}
+	afterFailure := service.Snapshot().CLIPTreasury
+	if afterFailure.TreasuryBalance != before.TreasuryBalance || afterFailure.LedgerOutstanding != before.LedgerOutstanding {
